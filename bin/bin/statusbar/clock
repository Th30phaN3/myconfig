#!/bin/bash
#
# Show date.
# Display calendar for current month when right clicked.
# Display calendar for next 3 months when left clicked.

echo " $(date '+%A %d %b %H:%M')"

case "${BLOCK_BUTTON}" in
  1) notify.sh "Calendrier:" "$(cal -n 3)" ;;
  3) notify.sh "Calendrier:" "$(cal)" ;;
esac

