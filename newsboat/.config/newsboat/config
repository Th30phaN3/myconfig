articlelist-format "%D %?T?|%-17T| ?%t"
articlelist-title-format "%N %V - %T (%u unread, %t total)"
datetime-format "%e %B %R"
dialogs-title-format "%N %V - Dialogs"
feedlist-format "%S %2U/%-3c  %t %> %-12T"
feedlist-title-format "%N %V - Your feeds (%u unread, %t total)%?T? - tag %T&?"
filebrowser-title-format "%N %V - %?O?Open File&Save File? - %f"
help-title-format "%N %V - Help"
itemview-title-format "%N %V - Article: %T"
notify-format "Newsboat: finished reload, %f unread feeds (%n unread articles total)"
searchresult-title-format "%N %V - Search result (%u unread, %t total)"
selectfilter-title-format  "%N %V - Select Filter"
selecttag-title-format "%N %V - Select Tag"
urlview-title-format "%N %V - URLs"

color listnormal          color13  color0
color listfocus           color0  color2
color listnormal_unread   color3  color0
color listfocus_unread    color0  color2
color info                color4  color3  bold
color background          color7  color0
color article             color7  color0

auto-reload yes
browser "/usr/bin/vivaldi"
#browser "link_handler.sh"
#download-full-page yes
download-retries 2
error-log "~/.config/newsboat/error.log"
#external-url-viewer "/usr/bin/urlview"
#external-url-viewer "urlscan -dc -r 'link_handler.sh {}'"
feed-sort-order lastupdated
keep-articles-days 14
max-items 100
notify-program notify-send
openbrowser-and-mark-jumps-to-next-unread yes
refresh-on-startup yes
reload-time 300
reload-threads 4
save-path "~/.config/newsboat"
wrap-scroll yes

highlight articlelist "gentoo"  color1
highlight article "(^Fil:.*|^Titre:.*|^Auteur:.*)" cyan default bold
highlight article "(^Lien:.*|^Date:.*)" default default
highlight article "https?://[^ ]+" green default
highlight article "^(Titre):.*$" blue default
highlight article "\\[[0-9][0-9]*\\]" magenta default bold
highlight article "\\[image\\ [0-9]+\\]" green default bold
highlight article ":.*\\(lien\\)$" cyan default
highlight article ":.*\\(image\\)$" blue default

ignore-article "*" "title =~ \"agile|Windows|SEO|trans(exual|gender)?|diversity|Gnome|Ubuntu|NVIDIA|PODCAST|VID(E|É)O|Sponsor|Advertisement\""

bind-key "LEFT" quit
bind-key "RIGHT" open
bind-key q hard-quit
bind-key o open-in-browser-and-mark-read

#macro , open-in-browser
#macro a set browser "tsp yt-dlp --embed-metadata -xic -f bestaudio/best --restrict-filenames" ; open-in-browser ; set browser "link_handler.sh"
#macro v set browser "setsid -f mpv" ; open-in-browser ; set browser "link_handler.sh"
#macro d set browser "dmenuhandler" ; open-in-browser ; set browser "link_handler.sh"
#macro c set browser "echo %u | xclip -r -sel c" ; open-in-browser ; set browser "link_handler.sh"

macro v set browser "setsid nohup mpv %u"; open-in-browser ; set browser "/usr/bin/vivaldi"
macro m set browser "mpv %u"; open-in-browser ; set browser "/usr/bin/vivaldi"
